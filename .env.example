# Fill these in on the machine that runs the cron. Never commit this file.
# All keys are free. Leave blank to skip that source.

# Discord alerts (required for notifications)
# Create: Discord channel settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# Adzuna — broadest US commercial coverage. Free: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs — federal ServiceNow roles. Free key: https://api.data.gov/signup/
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Jobicy needs no key (keyless, remote-only).
